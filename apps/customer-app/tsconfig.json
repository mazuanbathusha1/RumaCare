{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@rumacare/shared": ["../../packages/shared/src"]
    },
    "types": ["react", "react-native"]
  },
  "include": ["index.ts", "src/**/*", "app.config.ts"]
}
