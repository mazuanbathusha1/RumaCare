DATABASE_URL=postgresql://postgres:rumacare@localhost:5432/rumacare?schema=public
JWT_SECRET=dev-secret-change-me
PORT=3001
UPLOAD_DIR=./uploads

# File storage: "local" (default, writes to UPLOAD_DIR) or "s3"
STORAGE_DRIVER=local
# S3/R2 config (only required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
# Leave blank for AWS S3; set e.g. https://<account>.r2.cloudflarestorage.com for R2
S3_ENDPOINT=
# true for R2 / MinIO; false for AWS S3
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public prefix used for non-signed URLs, e.g. https://cdn.rumacare.my
S3_PUBLIC_URL_PREFIX=

# iPay88 payment gateway (sandbox: register at https://merchant.ipay88.com.my)
IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=
IPAY88_PAYMENT_URL=https://payment.ipay88.com.my/ePayment/entry.asp
IPAY88_RESPONSE_URL=http://localhost:3001/api/payments/ipay88/response
IPAY88_BACKEND_URL=http://localhost:3001/api/payments/ipay88/backend
